{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "queuenow-queue-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "durable_objects": {
    "bindings": [
      {
        "name": "QUEUES",
        "class_name": "QueueDurableObject"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "queuenow",
      "migrations_dir": "migrations"
    }
  ],
  "exports": {
    "QueueDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
